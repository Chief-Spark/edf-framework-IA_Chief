# ─────────────────────────────────────────────────────────────────────────
# Bloque HOCON parametrizable — oxygen.stage.pinning para {{INGESTA_NOMBRE}}
# ─────────────────────────────────────────────────────────────────────────
#
# Esta plantilla NO reemplaza pinning-application.conf completo. Es el bloque
# de claves con efecto directo verificado en el código real de oxygen-pinning
# que dependen del mapeo de identidad de esta ingesta. Las claves de
# infraestructura de ejecución (env.conf, spark.conf) están fuera de alcance
# de este skill.
#
# Cada clave trae su propio comentario con la regla y el estado de
# confirmación — no borres estos comentarios al generar el archivo final,
# son la trazabilidad que el revisor humano necesita.
#
# ── Modo Colombia (bureau.colombia_innersource; SKILL.md «Modo Colombia») ──
# La aplicación de Pinning es COMPARTIDA: lee todas las fuentes bajo
# curatedDir/*/* (PinningIOUtils.scala:23-31) y cada clave de
# oxygen.stage.pinning vale para todas. En modo Colombia NO se escribe el
# bloque oxygen.stage.pinning de abajo: se entrega solo esta lista de
# verificación, con el valor vigente que el equipo confirma en el conf
# compartido. Si la ingesta necesita otro valor en una clave compartida, es
# un bloqueo que se reporta, no una clave que se escribe.
#
#   VERIFICAR identifyingAttributesFile = lista compartida de Colombia
#             (identifying-attributes-new.json)
#   VERIFICAR identityMatcher           = matcher compartido de Colombia
#             (ColombiaIdentityMatcher / IdentityImpl, steering 11 §6 #7)
#   VERIFICAR reusePin                  = valor vigente del conf compartido.
#             NO SE ESCRIBE (HF-57). Es global: SparkPinner.scala:223 lo lee
#             una vez y :409 decide para toda la corrida. false renumera los
#             PIN de TODAS las fuentes (:979-985); solo con true la persona
#             existente recibe su PIN (:888-905). «Ingesta nueva → reusePIN =
#             false» en una spec = la ingesta no tiene generación previa
#             propia, no un valor de la clave global. Cambiar la clave es N4:
#             se documenta y se escala (steering 06 §3).
#             Valor de la fuente (dato, no se genera): {{REUSE_PIN_VALOR_FUENTE}}
#   VERIFICAR domainDictionaryFile, clusterSplitter, nearNeighborBlockSize,
#             pinningVleRange, groupSSR = valores vigentes del conf compartido
#
# COLAPSO SILENCIOSO (HF-58): nunca dejes, como «arranque», ISIdentityMatcher
# (o RIIdentityMatcher) ni la lista de ejemplo identifying-attributes.json
# (nationalId, firstName, cellPhone…) con eventos de Colombia (standardizedId*).
# Esos slots no existen en el evento: todos valen "" (IdentityMatcher.scala:46-49),
# todas las identidades quedan iguales y se agrupan por identityId en UNA sola
# antes de compararse (SparkPinner.scala:1756-1770). La llave de vecinos "" se
# filtra con groupSSR = true (:676) y los bloques >= 700 se descartan (:719-723).
# Resultado: un solo PIN para todas las personas, sin error.
#
# ── Fuera de modo Colombia (aplicación propia de la ingesta) ──

oxygen.stage.pinning {

  paths {
    # Lista de un solo elemento — el motor ignora silenciosamente cualquier
    # elemento adicional. [C] si identifying-attributes.json ya fue generado.
    # Modo Colombia: NO redefinir; la lista compartida identifying-attributes-new.json
    # ya está en el conf de Colombia (SKILL.md, Modo Colombia).
    identifyingAttributesFile = ["identifying-attributes.json"]

    # Domain dictionary propio de Pinning (AUD-P1). SparkPinner lo lee de
    # oxygen.stage.pinning.paths.domainDictionaryFile (SparkPinner.scala:192-198);
    # si falta, captura NoSuchElementException, solo deja un warn y sigue con "".
    # Fail-silent: confirmar en el fork si el conf del ambiente ya lo define.
    # Modo Colombia: si la clave ya existe en el conf compartido, NO redefinir.
    domainDictionaryFile = {{DOMAIN_DICTIONARY_FILE_O_PENDIENTE}}
  }

  # TODO(decisión de negocio pendiente, ver references/decisiones-pendientes.md
  # categoría 1): FQCN del IdentityMatcher a usar. Si no hay decisión de
  # diseño sobre un matcher propio para {{INGESTA_NOMBRE}}, este valor es un
  # ARRANQUE heredado del matcher de referencia, NO una decisión técnica
  # cerrada — ajústalo según lo que el equipo decida.
  # Solo fuera de modo Colombia. Con eventos de Colombia el matcher de
  # referencia colapsa todas las identidades en un PIN (HF-58, arriba).
  identityMatcher = "{{IDENTITY_MATCHER_FQCN}}"

  # Sin FQCN por defecto — solo completar si existe evidencia de que esta
  # ingesta requiere partir clusters que el grafo unió pero que reglas de
  # dominio dictan mantener separados.
  # VERIFICAR EN EL FORK el nombre de la clave (AUD-P1): SparkPinner.scala:221
  # lee oxygenConf.oxygen.CLUSTER_SPLITTER, una constante de oxygen-global que no
  # está en la copia del motor; ningún .conf del repo trae "clusterSplitter".
  # Si el nombre no coincide, el motor no aplica splitter y no avisa.
  clusterSplitter = {{CLUSTER_SPLITTER_FQCN_O_NULL}}

  # Clave GLOBAL de la aplicación (SparkPinner.scala:223, :409): vale para
  # todas las fuentes que lee esta aplicación, no solo para esta ingesta.
  # true = pinning estático (reusa los PIN del identity-pin-map de la
  # generación de referencia; una identidad sin PIN previo recibe uno nuevo).
  # false = pinning dinámico: TODOS los PIN de la aplicación se renumeran
  # (zipWithUniqueId + pinningVleRange, :979-985).
  # Solo se escribe si la aplicación es propia de esta ingesta (nunca en modo
  # Colombia, HF-57) y con confirmación explícita del valor [C].
  reusePin = {{REUSE_PIN}}

  # Umbral de tamaño de bloque near-neighbor. Bloques >= este valor se
  # DESCARTAN SILENCIOSAMENTE del matching pairwise (fail-silent, ver
  # Diseño/logica-pinning.md §9 para el detalle verificado). Evaluar contra
  # el volumen real esperado de esta ingesta antes de aceptar el default.
  nearNeighborBlockSize = {{NEAR_NEIGHBOR_BLOCK_SIZE}}  # default de plataforma: 700

  # Rango [0, N) reservado para pines VLE/celebrity.
  pinningVleRange = {{PINNING_VLE_RANGE}}  # default de plataforma: 2000

  # groupSSR tiene un conflicto conocido entre el default de plataforma (true)
  # y el valor del .conf de ejemplo del repo (false) — ninguno de los dos es
  # evidencia de negocio. NO fijar este valor sin una decisión explícita;
  # ver references/decisiones-pendientes.md antes de completar.
  groupSSR = {{GROUP_SSR_O_PENDIENTE}}
}

# Vive conceptualmente en Synthesis/Consistency, pero su clave HOCON real
# está anidada bajo oxygen.stage.consistencyCheck en el .conf del repo.
oxygen.stage.consistencyCheck {
  # null salvo evidencia de que esta ingesta requiere migración de relaciones
  # suscriptor-cuenta entre generaciones.
  relationshipMigrationProcessorClassName = {{RELATIONSHIP_MIGRATION_PROCESSOR_FQCN_O_NULL}}
}
