{
  "domain": "FIXTURE-SINTETICO-cuentas",
  "calculations": [
    {
      "name": "resumenCuentas",
      "type": "ALL",
      "select": ["accountId"],
      "groupBy": ["accountId"],
      "contains": [
        { "name": "saldos", "section": "saldoPorCuenta" },
        { "name": "fantasma", "section": "seccionQueNoExiste" }
      ]
    },
    {
      "name": "saldoPorCuenta",
      "type": "AGGREGATES",
      "select": ["accountId"],
      "groupBy": ["accountId"],
      "aggregates": [ { "function": "SUM", "field": "balance", "name": "sum" } ]
    }
  ]
}
