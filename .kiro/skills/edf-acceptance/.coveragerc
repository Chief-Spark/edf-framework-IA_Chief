# Cobertura de los scripts Python VIGENTES del skill (AC-31). Se lee al correr coverage desde la raíz del skill.
# Desde 1.6.0 (2026-11-18) render_templates.py es el generador vigente y entra en la medición.
# P-5: el 80 % se comprueba por script, con un `coverage report --include=<script> --fail-under=80` por script.
[run]
source = scripts
omit =
    scripts/tests/*

[report]
omit =
    scripts/tests/*
precision = 2
show_missing = True
