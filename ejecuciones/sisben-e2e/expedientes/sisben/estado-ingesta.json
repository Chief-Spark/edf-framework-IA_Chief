  "preguntas_abiertas": [
    {
      "id": "PA-001",
      "pregunta": "¿Con qué mecanismo se cumple R-26 / HU §5.6 (la sección #sisben solo para los PIN del archivo vigente)? Opciones: (a) archivo.metadata fileLoadType en Validation; (b) inferDelete en Acceptance; (c) lógica en el enricher de State Calculation; (d) el motor ya lo resuelve.",
      "origen": "Analista (INT-001): spec §13 y HU R-26 exigen el resultado pero no el mecanismo.",
      "etapa_afectada": "analisis",
      "bloqueante": true,
      "estado": "resuelta",
      "abierta_en": "2026-11-24T17:11:35-05:00",
      "resuelta_en": "2026-11-24T17:20:06-05:00",
      "respuesta": "[SIMULADO · aprobador SIM-DEV-01] Resuelta por las fuentes: R-26 se cumple en State Calculation (HU R-26, §5.6, §6; spec §13). Validation, Acceptance, Curation y Synthesis no cambian (spec Anexo A, §12; HU §6). Las alternativas (a) archivo.metadata/fileLoadType y (b) inferDelete quedan descartadas mientras no exista una versión nueva de la HU y la spec (HU §3). El mecanismo concreto dentro de la etapa 6 pasa a PA-002.",
      "ref_bitacora": "BIT-0009"
    },
    {
      "id": "PA-002",
      "pregunta": "En State Calculation (statecalc-foundation/enricher), ¿cómo se determina el corte vigente de SISBEN y cómo se excluye la sección #sisben de los PIN cuyo último evento SISBEN no pertenece a ese corte (HU R-26, §5.6)? Opciones compatibles: (c1) filtro en el enricher comparando fechaCorte curado (spec §10.1) con el corte vigente (máximo fechaCorte o corte del último archivo aceptado; toca [A:CQ-006]); (d) el motor ya lo cumple, solo con evidencia de código o pipeline. Fuera de alcance sin nueva versión de HU/spec: cambios al Anexo A, a Acceptance o a Synthesis.",
      "origen": "Cierre de PA-001 (aprobador SIM-DEV-01, INT-003); HU R-26, §5.6, §6; spec §13, §10.1, §10.3; auditoría AUD-E0-07.",
      "etapa_afectada": "state_calculation",
      "bloqueante": true,
      "estado": "abierta",
      "abierta_en": "2026-11-24T17:20:06-05:00",
      "resuelta_en": null,
      "respuesta": null,
      "ref_bitacora": "BIT-0010"
    }
  ],
